<mxfile host="drawio" type="device"><diagram id="03_registry_lifecycle" name="03_registry_lifecycle"><mxGraphModel dx="1980" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1980" height="900" as="geometry"/></mxCell><mxCell id="title" value='&lt;b&gt;03  Registry lifecycle&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:13px"&gt;Nine stages; the server validates every move against configs/lifecycle.yaml and the caller&amp;#x27;s role&lt;/font&gt;' style="fillColor=#4DA1F5;strokeColor=none;shadow=1;gradientColor=none;fontSize=14;align=left;spacingLeft=50;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=20;spacingLeft=24;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1980" height="64" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;Managed apps only: inference runs through the control plane&lt;/b&gt;" style="shape=rect;strokeColor=none;strokeWidth=2;shadow=0;gradientColor=none;fontColor=#757575;align=left;html=1;fontStyle=0;spacingTop=3;fillColor=#E3F2FD;verticalAlign=top;fontSize=10;spacingLeft=10;spacing=0;fontSize=13;fontColor=#5F6368;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="920" height="200" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;From any stage · governance_admin, with a reason&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=2;html=1;strokeColor=none;gradientColor=none;shadow=0;dashed=1;strokeColor=#4284F3;fontSize=10;fontColor=#9E9E9E;align=left;verticalAlign=top;spacing=0;spacingTop=3;fillColor=none;dashPattern=1 2;strokeWidth=2;fontStyle=0;spacingLeft=10;fontSize=13;fontColor=#5F6368;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="880" y="600" width="860" height="200" as="geometry"/></mxCell><mxCell id="intake" value="intake&lt;br&gt;owner and a problem&lt;br&gt;of 30 or more words" style="fillColor=#ffffff;strokeColor=#dddddd;shadow=1;strokeWidth=1;rounded=1;absoluteArcSize=1;arcSize=2;fontSize=13;fontStyle=0;fontColor=#3C4043;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="200" height="80" as="geometry"/></mxCell><mxCell id="case" value="business_case&lt;br&gt;volume, value hypothesis,&lt;br&gt;cost estimate (ASSUMPTION)" style="fillColor=#ffffff;strokeColor=#dddddd;shadow=1;strokeWidth=1;rounded=1;absoluteArcSize=1;arcSize=2;fontSize=13;fontStyle=0;fontColor=#3C4043;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="400" width="220" height="80" as="geometry"/></mxCell><mxCell id="gates" value="review_gates" style="fillColor=#ffffff;strokeColor=#dddddd;shadow=1;strokeWidth=1;rounded=1;absoluteArcSize=1;arcSize=2;fontSize=13;fontStyle=0;fontColor=#3C4043;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;strokeColor=#4284F3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="405" width="170" height="70" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;Review gates by risk tier&lt;/b&gt; (configs/lifecycle.yaml)&lt;br&gt;low: one reviewer&lt;br&gt;medium: governance review (governance_admin)&lt;br&gt;high: governance + security review&lt;br&gt;The submitter can never approve.&lt;br&gt;Approvals stay valid for 180 days." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#E6D28A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#3C4043;" vertex="1" parent="1"><mxGeometry x="500" y="600" width="330" height="140" as="geometry"/></mxCell><mxCell id="evaluation" value="evaluation&lt;br&gt;scorecard on frozen cases" style="fillColor=#ffffff;strokeColor=#dddddd;shadow=1;strokeWidth=1;rounded=1;a
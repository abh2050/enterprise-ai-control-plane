xitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#3C4043;" edge="1" parent="1" source="app_events.app_id" target="app_snapshots.app_id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c90" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5F6368;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=12;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#3C4043;" edge="1" parent="1" source="experiment_results.app_id" target="app_snapshots.app_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="554"/><mxPoint x="560" y="194"/></Array></mxGeometry></mxCell><mxCell id="c91" value="experiment_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5F6368;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=12;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#3C4043;" edge="1" parent="1" source="experiment_results.experiment_id" target="attempts.experiment_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="578"/><mxPoint x="620" y="708"/></Array></mxGeometry></mxCell><mxCell id="c92" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5F6368;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=12;endSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#3C4043;" edge="1" parent="1" source="attempts.app_id" target="app_snapshots.app_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="684"/><mxPoint x="660" y="194"/></Array></mxGeometry></mxCell><mxCell id="c93" value="app_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5F6368;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=12;endSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#3C4043;" edge="1" parent="1" source="incidents.app_id" target="app_snapshots.app_id"><mxGeometry relative="1" x="-0.55" as="geometry"></mxGeometry></mxCell><mxCell id="c94" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5F6368;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=12;endSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#3C4043;" edge="1" parent="1" source="product_events.app_id" target="app_snapshots.app_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="554"/><mxPoint x="1200" y="194"/></Array></mxGeometry></mxCell><mxCell id="c95" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5F6368;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=12;endSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#3C4043;" edge="1" parent="1" source="shadow_results.app_id" target="app_snapshots.app_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="824"/><mxPoint x="1240" y="194"/></Array></mxGeometry></mxCell><mxCell id="notes" value="&lt;b&gt;How to read this&lt;/b&gt;&lt;br&gt;Dataset control_plane (US), created by infra/bigquery.sql.&lt;br&gt;Every table is partitioned by event_date and clustered by app_id.&lt;br&gt;PK: the MERGE key; a nightly re-export cannot double-count.&lt;br&gt;BigQuery has no foreign keys: the lines are the joins the&lt;br&gt;queries use (analytics/queries.py). app_snapshots holds one row&lt;br&gt;per app per day; its latest row is the current app.&lt;br&gt;Each table has a _staging twin loaded fresh before the MERGE.&lt;br&gt;No message text is exported (export.py checks every row)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#E6D28A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#3C4043;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="600" height="176" as="geometry"/></mxCell><mxCell id="c96" value="&lt;b&gt;Green&lt;/b&gt;: the app dimension" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1E8E3E;" vertex="1" parent="1"><mxGeometry x="1060" y="1150" width="260" height="20" as="geometry"/></mxCell><mxCell id="c97" value="&lt;b&gt;Blue&lt;/b&gt;: append-only fact tables" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#4284F3;" vertex="1" parent="1"><mxGeometry x="1060" y="1172" width="260" height="20" as="geometry"/></mxCell><mxCell id="c98" value="&lt;b&gt;Grey&lt;/b&gt;: export bookkeeping" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#80868B;" vertex="1" parent="1"><mxGeometry x="1060" y="1194" width="260" height="20" as="geometry"/></mxCell><mxCell id="c99" value="Crow&amp;#x27;s foot: many rows to one app, or many results to one experiment" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="1320" y="1150" width="420" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

Bottom=2;" vertex="1" parent="1"><mxGeometry x="963.095" y="590" width="45.8095" height="52" as="geometry"/></mxCell><mxCell id="policy" value="Deterministic&lt;br&gt;decision policy" style="fillColor=#ffffff;strokeColor=#dddddd;shadow=1;strokeWidth=1;rounded=1;absoluteArcSize=1;arcSize=2;fontSize=13;fontStyle=0;fontColor=#3C4043;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;strokeColor=#4284F3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1240" y="371" width="200" height="70" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;Decision policy: first matching rule wins&lt;/b&gt;&lt;br&gt;1  sensitive intent: review&lt;br&gt;2  out_of_scope: abstain&lt;br&gt;3  classifier probability at or above its threshold: auto&lt;br&gt;4  LLM agrees with the classifier and probability at or&lt;br&gt;    above the agreement threshold: auto&lt;br&gt;5  intent outside the eligible cohort: review&lt;br&gt;6  otherwise: review&lt;br&gt;Thresholds were tuned on the dev split and frozen.&lt;br&gt;LLM self-reported confidence is never used." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#E6D28A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#3C4043;" vertex="1" parent="1"><mxGeometry x="1170" y="640" width="470" height="186" as="geometry"/></mxCell><mxCell id="auto" value="auto route" style="fillColor=#ffffff;strokeColor=#dddddd;shadow=1;strokeWidth=1;rounded=1;absoluteArcSize=1;arcSize=2;fontSize=13;fontStyle=0;fontColor=#3C4043;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;strokeColor=#34A853;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1540" y="250" width="160" height="56" as="geometry"/></mxCell><mxCell id="review" value="human review" style="fillColor=#ffffff;strokeColor=#dddddd;shadow=1;strokeWidth=1;rounded=1;absoluteArcSize=1;arcSize=2;fontSize=13;fontStyle=0;fontColor=#3C4043;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;" vertex=
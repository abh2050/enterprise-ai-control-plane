<mxfile host="drawio" type="device"><diagram id="11_public_demo" name="11_public_demo"><mxGraphModel dx="1700" dy="820" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1700" height="820" as="geometry"/></mxCell><mxCell id="title" value='&lt;b&gt;11  Public demo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:13px"&gt;The GitHub Pages console runs the unchanged backend inside the visitor&amp;#x27;s browser; nothing a visitor does leaves the tab&lt;/font&gt;' style="fillColor=#4DA1F5;strokeColor=none;shadow=1;gradientColor=none;fontSize=14;align=left;spacingLeft=50;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=20;spacingLeft=24;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1700" height="64" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;Browser tab&lt;/b&gt;" style="shape=rect;strokeColor=none;strokeWidth=2;shadow=0;gradientColor=none;fontColor=#757575;align=left;html=1;fontStyle=0;spacingTop=3;fillColor=#F6F6F6;verticalAlign=top;fontSize=10;spacingLeft=10;spacing=0;fontSize=13;fontColor=#5F6368;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="900" height="560" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Web Worker&lt;/b&gt;" style="shape=rect;strokeColor=none;strokeWidth=2;shadow=0;gradientColor=none;fontColor=#757575;align=left;html=1;fontStyle=0;spacingTop=3;fillColor=#E3F2FD;verticalAlign=top;fontSize=10;spacingLeft=10;spacing=0;fontSize=13;fontColor=#5F6368;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="740" y="160" width="500" height="450" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Not in the demo&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=2;html=1;strok
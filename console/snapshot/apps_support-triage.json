ent_id": "rel_llm_high_capability_v1_20261012T040607Z-release_proposed", "app_id": "support-triage", "kind": "release_proposed", "from_stage": null, "to_stage": null, "actor": "owner@example.com", "reason": "Proposed llm_high_capability_v1 with a 73-intent cohort", "evidence_refs": ["artifacts/releases/rel_llm_high_capability_v1_20261012T040607Z.json"], "created_at": "2026-10-12T04:06:07.422934+00:00"}, {"event_id": "rel_llm_low_cost_v1_20261012T040606Z-release_reject", "app_id": "support-triage", "kind": "release_reject", "from_stage": null, "to_stage": null, "actor": "admin@example.com", "reason": "Measured on the 1,540-case frozen set, gemini-3.1-flash-lite passes 3 of 10 gates: macro F1 0.839 against a 0.893 floor, five sensitive intents below 0.95 recall, and 0.95 on risk-suite sensitive routing. Even with those intents excluded, the cohort fails macro F1 and risk routing. It is also dominated: gemini-3.8-flash is more accurate and cheaper per call with caching.", "evidence_refs": ["artifacts/releases/rel_llm_low_cost_v1_20261012T040606Z.json"], "created_at": "2026-10-12T04:06:17.289079+00:00"}, {"event_id": "drill_shadow_llm_high_capability_v1_20261012T040728Z-0", "app_id": "support-triage", "kind": "drill_incident_opened", "from_stage": null, "to_stage": null, "actor": "monitoring", "reason": "Simulated day 10 (FIXTURE drill): review_rate 0.218 vs 0.217", "evidence_refs": ["artifacts/monitoring/drill_shadow_llm_high_capability_v1_20261012T040728Z.json"], "created_at": "2026-10-12T05:13:08.366244+00:00"}, {"event_id": "drill_shadow_llm_high_capability_v1_20261012T040728Z-1", "app_id": "support-triage", "kind": "drill_automation_paused", "from_stage": null, "to_stage": null, "actor": "admin@example.com", "reason": "Simulated day 10 (FIXTURE drill): Governance admin paused automation for Support Triage", "evidence_refs": ["artifacts/monitoring/drill_shadow_llm_high_capability_v1_20261012T040728Z.json"], "created_at": "2026-10-12T05:13:08.366244+00:00"}, {"event_
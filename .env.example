# Copy to .env. Defaults run fully local with no cloud credentials.

# fixture | iap   (fixture identity only binds to localhost)
IDENTITY_MODE=fixture
# fixture | vertex
PROVIDER_MODE=fixture
# memory | firestore
STORE_BACKEND=memory
# Set to use the Firestore emulator from docker compose
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GCP_PROJECT=demo-control-plane

BIND_HOST=127.0.0.1
BIND_PORT=8000

# Verified by `cp preflight` before live mode turns on (M3)
VERTEX_LOCATION=us-central1
VERTEX_LOW_COST_MODEL=gemini-3.1-flash-lite
VERTEX_HIGH_CAPABILITY_MODEL=gemini-3.8-flash

# IAP audience, set by deploy_gcp.sh (M6)
# IAP_AUDIENCE=/projects/123/locations/us-central1/services/control-plane

# Budget defaults in USD (stored as integer micro dollars)
BUDGET_APP_DAILY_USD=5
BUDGET_EXPERIMENT_USD=40
BUDGET_EXPERIMENT_TOTAL_USD=60
